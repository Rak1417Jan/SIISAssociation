@{
    var activeMenu = ViewData["ActiveMenu"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TEST INDUSTRIES ASSOCIATION</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-header">
        <div class="admin-header-left">
            <a asp-page="/Admin/Dashboard" class="admin-header-logo">VIA</a>
            <div class="admin-header-brand">
                <h1>TEST Industries Association</h1>
                <p class="tagline">Web-Based Member Management System</p>
            </div>
        </div>
        <div class="admin-header-right">
            <button type="button" class="admin-header-icon" aria-label="Notifications">
                <i class="fas fa-bell"></i>
            </button>
            <a href="#" class="admin-header-icon" aria-label="Support"><i class="fas fa-headset"></i></a>
            <a href="#" class="admin-header-icon" aria-label="Messages">
                <i class="fas fa-envelope"></i>
                <span class="badge">1</span>
            </a>
            <div class="admin-user-menu">
                <div class="admin-user-avatar">A</div>
                <span class="admin-user-name">Admin</span>
                <i class="fas fa-chevron-down" style="font-size: 0.7rem; color: #9e9e9e;"></i>
            </div>
        </div>
    </header>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-brand">
                <div class="admin-sidebar-logo">VIA</div>
                <div class="admin-sidebar-title">TEST Industries Association</div>
            </div>
            <nav class="admin-sidebar-nav">
                <a asp-page="/Admin/Dashboard" class="admin-nav-item @(activeMenu == "Dashboard" ? "active" : "")">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#" class="admin-nav-item"><i class="fas fa-users"></i><span>Manage Users</span></a>
                <a href="#" class="admin-nav-item"><i class="fas fa-shield-alt"></i><span>Role-Based Access</span></a>
                <a href="#" class="admin-nav-item"><i class="fas fa-map-marker-alt"></i><span>User Activity Logs</span></a>
                <a href="#" class="admin-nav-item"><i class="fas fa-key"></i><span>Password Reset</span></a>
                <a asp-page="/Admin/Firms/Index" class="admin-nav-item @(activeMenu == "Firms" ? "active" : "")">
                    <i class="fas fa-building"></i>
                    <span>Firms</span>
                </a>
                <a asp-page="/Admin/Members/Index" class="admin-nav-item @(activeMenu == "Members" ? "active" : "")">
                    <i class="fas fa-id-card"></i>
                    <span>Members</span>
                </a>
                <a asp-page="/Admin/CreateUser" class="admin-nav-btn-primary @(activeMenu == "CreateUser" ? "active" : "")">
                    <i class="fas fa-plus-circle"></i>
                    <span>Add New User</span>
                </a>
                <a asp-page="/Admin/Reports/Index" class="admin-nav-item @(activeMenu == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-bar"></i><span>Reports &amp; Analytics</span>
                </a>
                <a asp-page="/Admin/Announcements/Index" class="admin-nav-item @(activeMenu == "Announcements" ? "active" : "")">
                    <i class="fas fa-bullhorn"></i><span>Announcements</span>
                </a>
                <a href="#" class="admin-nav-item"><i class="fas fa-cog"></i><span>Settings</span></a>
            </nav>
            <div class="admin-sidebar-footer">
                <button type="button" class="admin-sidebar-toggle" aria-label="Collapse sidebar">
                    <i class="fas fa-arrow-left"></i>
                </button>
            </div>
        </aside>
        <main class="admin-main">
            @RenderBody()
        </main>
    </div>
    <footer class="admin-footer">© 2026 TEST Industries Association</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
