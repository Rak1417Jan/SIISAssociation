@page
@model AMMS.Web.Pages.Admin.Firms.IndexModel
@using AMMS.Web.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Firms";
    ViewData["ActiveMenu"] = "Firms";
}

<div class="admin-welcome">
    <h2>Welcome, Admin!</h2>
    <p class="subtitle">Admin Control Panel - Firms</p>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="admin-panel firm-message success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="admin-panel firm-message error">@Model.ErrorMessage</div>
}

<div class="admin-panel">
    <div class="admin-panel-header">
        <h3 class="admin-panel-title">Firm List</h3>
        <a asp-page="/Admin/Firms/AddFirm" class="btn-add-user"><i class="fas fa-plus"></i> Add Firm</a>
    </div>
    <div class="admin-table-wrap firm-table-wrap">
        <table class="admin-table firm-table">
            <thead>
                <tr>
                    <th>Firm Code</th>
                    <th>Firm Name</th>
                    <th>Type</th>
                    <th>Date of Establishment</th>
                    <th>GST No.</th>
                    <th>Reg No.</th>
                    <th>Address</th>
                    <th>Office Address</th>
                    <th>Telephone No.</th>
                    <th>Mobile No.</th>
                    <th>Email</th>
                    <th>Website</th>
                    <th>Products</th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Firms.Count == 0)
                {
                    <tr>
                        <td colspan="15" class="text-center">No firms found. <a asp-page="/Admin/Firms/AddFirm">Add Firm</a></td>
                    </tr>
                }
                else
                {
                    @foreach (var firm in Model.Firms)
                    {
                        <tr>
                            <td>@firm.FirmCode</td>
                            <td>@firm.FirmName</td>
                            <td>@FirmTypeHelper.DisplayName(firm.Type)</td>
                            <td>@(firm.DateOfEstablishment?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td>@(firm.GstNo ?? "-")</td>
                            <td>@(firm.RegNo ?? "-")</td>
                            <td>@(firm.Address ?? "-")</td>
                            <td>@(firm.OfficeAddress ?? "-")</td>
                            <td>@(firm.TelephoneNo ?? "-")</td>
                            <td>@(firm.MobileNo ?? "-")</td>
                            <td>@(firm.Email ?? "-")</td>
                            <td>@(firm.Website ?? "-")</td>
                            <td>@(firm.Products ?? "-")</td>
                            <td>
                                <div class="actions">
                                    <a asp-page="/Admin/Firms/EditFirm" asp-route-id="@firm.Id" class="btn-icon" aria-label="Edit"><i class="fas fa-edit"></i></a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@firm.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this firm?');">
                                        <button type="submit" class="btn-icon delete" aria-label="Delete"><i class="fas fa-trash-alt"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
