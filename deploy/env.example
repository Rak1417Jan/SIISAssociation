# Copy to deploy/.env and fill in before running scripts.
# cp deploy/env.example deploy/.env

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# Cloud SQL for SQL Server
CLOUDSQL_INSTANCE_NAME=amms-sql
# Format: PROJECT:REGION:INSTANCE
CLOUDSQL_CONNECTION_NAME=${GCP_PROJECT_ID}:${GCP_REGION}:${CLOUDSQL_INSTANCE_NAME}

# SQL login (created during setup or manually in Cloud SQL)
SQL_USER=sqlserver
SQL_PASSWORD=change-me-strong-password
SQL_DATABASE=AMMS

# Artifact Registry
AR_REPO=amms

# Cloud Run
RUN_SERVICE_ACCOUNT=amms-run
API_SERVICE_NAME=amms-api
WEB_SERVICE_NAME=amms-web

# Secrets (Secret Manager secret ids)
SECRET_DB_CONNECTION=amms-db-connection
SECRET_JWT_KEY=amms-jwt-key

# JWT signing key for Secret Manager (leave empty to auto-generate in gcp-setup.sh)
JWT_KEY=

# JWT (non-secret config on Cloud Run)
JWT_ISSUER=MVEAAPI
JWT_AUDIENCE=YourAppUsers

# Serverless VPC connector for Cloud Run → Cloud SQL private IP (.NET SqlClient)
VPC_CONNECTOR=amms-connector
# Optional overrides for enable-cloudrun-private-sql.sh
# VPC_PEERING_RANGE_NAME=google-managed-services-default
# VPC_CONNECTOR_RANGE=10.8.0.0/28
# VPC_NETWORK=default
